#ifndef _LIBCPP_STDERROR
#define _LIBCPP_STDERROR

#include <__config>
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <string>
#include <system_error>

#if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#  pragma GCC system_header
#endif

_LIBCPP_BEGIN_NAMESPACE_STD

enum class except_t : unsigned char {
  no_except      = 0, ///< Function does not throw.
  static_except  = 1, ///< Function throws std::error (static exceptions).
  dynamic_except = 2  ///< Function may throw dynamic exceptions.
};

template <class DomainType>
class status_code;
class _generic_code_domain;
using generic_code = status_code<_generic_code_domain>;

/// Abstract base class for status code domains (P1028R6).
///
/// Each domain is identified by a random 64-bit unique id and provides
/// virtual operations on the type-erased payload carried by a status_code.
class status_code_domain {
  template <class DomainType>
  friend class status_code;

public:
  using unique_id_type = unsigned long long;

private:
  unique_id_type _id;

protected:
  constexpr explicit status_code_domain(unique_id_type id) noexcept : _id(id) {}

  status_code_domain(const status_code_domain&)            = default;
  status_code_domain(status_code_domain&&)                 = default;
  status_code_domain& operator=(const status_code_domain&) = default;
  status_code_domain& operator=(status_code_domain&&)      = default;
  ~status_code_domain()                                    = default;

public:
  constexpr unique_id_type id() const noexcept { return _id; }
  constexpr bool operator==(const status_code_domain& o) const noexcept { return _id == o._id; }

  virtual const char* name() const noexcept                        = 0;
  virtual bool do_failure(const status_code<void>&) const noexcept = 0;
  virtual string do_message(const status_code<void>&) const        = 0;
};

/// Type-erased, immovable status code base.  Carries only the domain pointer;
/// the payload lives in derived classes.
template <>
class status_code<void> {
  template <class DomainType>
  friend class status_code;

protected:
  const status_code_domain* _domain{nullptr};

  status_code() = default;
  constexpr explicit status_code(const status_code_domain* d) noexcept : _domain(d) {}
  status_code(const status_code&)            = default;
  status_code(status_code&&)                 = default;
  status_code& operator=(const status_code&) = default;
  status_code& operator=(status_code&&)      = default;
  ~status_code()                             = default;

public:
  constexpr bool empty() const noexcept { return _domain == nullptr; }
  constexpr const status_code_domain& domain() const noexcept { return *_domain; }
  bool failure() const noexcept { return _domain && _domain->do_failure(*this); }
  string message() const { return _domain ? _domain->do_message(*this) : "(empty)"; }
};

/// Typed status code.  Inherits the domain pointer from status_code<void> and
/// adds a payload of DomainType::value_type.
template <class DomainType>
class status_code : public status_code<void> {
  template <class T>
  friend class status_code;

public:
  using domain_type = DomainType;
  using value_type  = typename DomainType::value_type;

  status_code()                              = default;
  status_code(const status_code&)            = default;
  status_code(status_code&&)                 = default;
  status_code& operator=(const status_code&) = default;
  status_code& operator=(status_code&&)      = default;
  ~status_code()                             = default;

  template <class... Args>
  constexpr explicit status_code(const DomainType& d, Args&&... args) noexcept
      : status_code<void>(&d), _value(static_cast<Args&&>(args)...) {}

  constexpr const value_type& value() const noexcept { return _value; }

private:
  value_type _value{};
};

/// A status_code that is always a failure. Terminates if constructed with a
/// non-failure value.
template <class DomainType>
class errored_status_code : public status_code<DomainType> {
  using _base = status_code<DomainType>;

public:
  using typename _base::value_type;

  errored_status_code()                                      = default;
  errored_status_code(const errored_status_code&)            = default;
  errored_status_code(errored_status_code&&)                 = default;
  errored_status_code& operator=(const errored_status_code&) = default;
  errored_status_code& operator=(errored_status_code&&)      = default;
  ~errored_status_code()                                     = default;

  constexpr explicit errored_status_code(_base&& code) noexcept : _base(static_cast<_base&&>(code)) {
    if (!this->failure())
      __builtin_trap();
  }

  constexpr explicit errored_status_code(const _base& code) noexcept : _base(code) {
    if (!this->failure())
      __builtin_trap();
  }

  /// Implicit construction from compatible status_code conversions (e.g. errc).
  template <class T>
    requires(!is_same_v<remove_cvref_t<T>, errored_status_code> && is_constructible_v<_base, T>)
  constexpr errored_status_code(T&& v) noexcept : _base(static_cast<T&&>(v)) {
    if (!this->failure())
      __builtin_trap();
  }
};

/// Domain for std::errc (POSIX) values.  The value_type is intptr_t so that
/// status_code<_generic_code_domain> is exactly two pointers wide.
class _generic_code_domain final : public status_code_domain {
public:
  using value_type = intptr_t;

  constexpr _generic_code_domain() noexcept : status_code_domain(0x746d6354f4f733e9ULL) {}

  static constexpr const _generic_code_domain& get() noexcept;

  const char* name() const noexcept override { return "generic domain"; }

  bool do_failure(const status_code<void>& code) const noexcept override {
    return static_cast<const generic_code&>(code).value() != 0;
  }

  string do_message(const status_code<void>& code) const override {
    return generic_category().message(static_cast<int>(static_cast<const generic_code&>(code).value()));
  }
};

inline constexpr _generic_code_domain _generic_code_domain_instance{};

constexpr const _generic_code_domain& _generic_code_domain::get() noexcept { return _generic_code_domain_instance; }

/// Enable implicit construction of generic_code from an errc integer value.
inline generic_code make_status_code(int c) noexcept {
  return generic_code(_generic_code_domain::get(), static_cast<intptr_t>(c));
}

using system_code = status_code<_generic_code_domain>;
using error       = errored_status_code<_generic_code_domain>;

static_assert(sizeof(system_code) == 2 * sizeof(void*), "system_code must be exactly two pointers in size");
static_assert(sizeof(error) == 2 * sizeof(void*), "error must be exactly two pointers in size");

_LIBCPP_END_NAMESPACE_STD

#endif // _LIBCPP_STDERROR
